{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStructuredIntelBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::nangman-crypto-dev-intel-structuring-l1-<account-suffix>"
    },
    {
      "Sid": "ReadStructuredIntelPackets",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::nangman-crypto-dev-intel-structuring-l1-<account-suffix>/structured-intel-packet/schema=structured_intel_packet_v1/*"
    },
    {
      "Sid": "ValidateSupervisorOutputBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>"
    },
    {
      "Sid": "WriteSupervisorReports",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/domain-replay-supervisor/*"
    }
  ]
}
